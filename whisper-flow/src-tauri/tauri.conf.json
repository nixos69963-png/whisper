{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper Flow",
  "version": "0.1.0",
  "identifier": "com.whisperflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whisper Flow",
        "width": 246,
        "height": 68,
        "minWidth": 246,
        "minHeight": 68,
        "maxWidth": 246,
        "maxHeight": 68,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"]
  }
}
